# ===== Base: CUDA + Ubuntu LTS that’s friendly with ROS Noetic if you later want it =====
ARG UBUNTU_VERSION=20.04
ARG CUDA_TAG=11.8.0
FROM nvidia/cuda:${CUDA_TAG}-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    MY_WORKSPACE=/root \
    GTEST_ROOT=/opt/gtest/install \
    CC=gcc CXX=g++

# ----- OS deps (per wiki) -----
# OpenCV, Eigen, Boost filesystem; plus common build tools and pkg-config.
# (We add a couple of small extras that won’t hurt: git, ca-certificates, wget)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential cmake git pkg-config ca-certificates wget \
      libopencv-dev libeigen3-dev libboost-filesystem-dev \
    && rm -rf /var/lib/apt/lists/*

# ----- Googletest 1.7.0 (exact version per wiki) -----
RUN mkdir -p "${MY_WORKSPACE}" /opt/gtest && cd "${MY_WORKSPACE}" && \
    git clone https://github.com/google/googletest.git && \
    cd googletest && git checkout release-1.7.0 && \
    mkdir build && cd build && cmake .. && make -j"$(nproc)" && \
    cd .. && mkdir -p "${GTEST_ROOT}" && \
    cp -r include "${GTEST_ROOT}/" && cp build/*.a "${GTEST_ROOT}/"

# ----- Build rpg_open_remode without ROS (per wiki) -----
# WORKDIR ${MY_WORKSPACE}
# RUN git clone https://github.com/uzh-rpg/rpg_open_remode.git && \
#     cd rpg_open_remode && mkdir -p build && cd build && \
#     cmake -DGTEST_ROOT="${GTEST_ROOT}" -DBUILD_ROS_NODE=OFF .. && \
#     make -j"$(nproc)"

# Optional: expose the compiled example as default entry (adjust as you wish)
WORKDIR ${MY_WORKSPACE}
